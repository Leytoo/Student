// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  REGISTRAR
  SAO
  LIBRARIAN
  ADMIN
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  COMPLETED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ClearanceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

// ─────────────────────────────────────────────────────────────────────────────
// Core Identity
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Registrar domain
  enrollments Enrollment[]

  // SAO domain
  incidents  Incident[]
  clearances Clearance[]

  // Librarian domain
  libraryRecords LibraryRecord[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Registrar Domain
// ─────────────────────────────────────────────────────────────────────────────

model Subject {
  id          String       @id @default(uuid())
  code        String       @unique
  title       String
  schedule    String
  units       Int          @default(3)
  instructor  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]

  @@map("subjects")
}

model Enrollment {
  id           String           @id @default(uuid())
  userId       String
  subjectId    String
  status       EnrollmentStatus @default(ENROLLED)
  midtermGrade Float?
  finalGrade   Float?
  remarks      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@map("enrollments")
}

// ─────────────────────────────────────────────────────────────────────────────
// SAO Domain
// ─────────────────────────────────────────────────────────────────────────────

model Incident {
  id           String           @id @default(uuid())
  studentId    String
  title        String
  description  String
  severity     IncidentSeverity @default(LOW)
  status       IncidentStatus   @default(OPEN)
  dateReported DateTime         @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("incidents")
}

model Clearance {
  id         String          @id @default(uuid())
  studentId  String
  department String // e.g. "SAO", "LIBRARY", "REGISTRAR"
  status     ClearanceStatus @default(PENDING)
  remarks    String?
  issuedAt   DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("clearances")
}

// ─────────────────────────────────────────────────────────────────────────────
// Librarian Domain
// ─────────────────────────────────────────────────────────────────────────────

model LibraryRecord {
  id         String     @id @default(uuid())
  studentId  String
  bookTitle  String
  bookIsbn   String?
  borrowedAt DateTime   @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  status     LoanStatus @default(ACTIVE)
  fineAmount Float      @default(0)
  finePaid   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("library_records")
}
